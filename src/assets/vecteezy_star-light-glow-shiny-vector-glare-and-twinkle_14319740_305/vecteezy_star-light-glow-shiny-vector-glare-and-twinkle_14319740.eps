   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Star light glow, , shiny vector glare and twinkle</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Star light glow, , shiny vector glare, bright white twinkle or explosion effect with radiant beams. Sparkles and magic flare graphic design elements, glitter and fireworks isolated realistic 3d set</rdf:li>
    </rdf:Alt>
